{
  "name": "wasm",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "asbuild:debug": "bunx asc src/index.ts --target debug --outFile build/debug.wasm --exportRuntime",
    "asbuild:release": "bunx asc src/index.ts --target release --outFile build/release.wasm --optimize --exportRuntime",
    "build": "bun run asbuild:release",
    "build:debug": "bun run asbuild:debug"
  },
  "dependencies": {
    "assemblyscript": "^0.27.0"
  }
}
